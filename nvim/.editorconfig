# Editorconfig ───────────────────────────────────────────────────────────────
root = true

# ── Defaults (all files) ────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ── Lua ─────────────────────────────────────────────────────────────────────
# Mirrors stylua.toml exactly: spaces, width 2, 80-col lines
[*.lua]
indent_style = space
indent_size = 2
max_line_length = 80

# ── Markdown ────────────────────────────────────────────────────────────────
# Trailing whitespace is meaningful in Markdown (two spaces = <br>)
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ── YAML / TOML / JSON (config files) ───────────────────────────────────────
[*.{yml,yaml,toml}]
indent_size = 2

# ── Shell scripts ───────────────────────────────────────────────────────────
[*.sh]
indent_size = 2

# vim:cc=+1:tw=78:ft=toml
