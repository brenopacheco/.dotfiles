find
	smart:  Snacks.picker.smart() end
	buffer: Snacks.picker.buffers() e

	git      files: Snacks.picker.files({ cwd = my.root() })
	dir      files: Snacks.picker.files()
	config   files: Snacks.picker.files({ cwd = vim.fn.stdpath("config") })
	recent   files: Snacks.picker.recent()
	git      grep:  Snacks.picker.grep({ dirs = { my.root() } })
	dir      grep:  Snacks.picker.grep()
	git word grep:  Snacks.picker.grep_word({ dirs = { my.root() } })
	dir word grep:  Snacks.picker.grep_word()
	buffer   grep:  Snacks.picker.grep_buffers()

	git branch:  Snacks.picker.git_branches()
	cmd history:
	help
	man

		{ "<leader>:", function() Snacks.picker.command_history() end, desc = "Command History" },
        { "<leader>sb", function() Snacks.picker.lines() end, desc = "Buffer Lines" },

        { "<leader>sd", function() Snacks.picker.diagnostics() end, desc = "Diagnostics" },
        { "<leader>sh", function() Snacks.picker.help() end, desc = "Help Pages" },
        { "<leader>sm", function() Snacks.picker.marks() end, desc = "Marks" },
        { "<leader>sM", function() Snacks.picker.man() end, desc = "Man Pages" },
        { "<leader>sq", function() Snacks.picker.qflist() end, desc = "Quickfix List" },
		{ "<c-/>",      function() Snacks.terminal() end, desc = "Toggle Terminal" },

	projects (builtin is not what I want)
	make/(targets?)
	docs/zeal/tldr
	zk/notes
	run/compile history
	option set/toggle

