#!/usr/bin/env perl
use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use Pod::Usage   qw(pod2usage);
use File::Path   qw(make_path);

=head1 SYNOPSIS

mycmd [-h|--help] [NAME]

=cut

my $help = 0;
GetOptions(
    'h|help' => \$help,
) or pod2usage(2);
pod2usage(1) if $help;

my $name = shift @ARGV;

my $home = $ENV{HOME};
make_path("$home/sketch");

# generate 10 random hex chars
open(my $urandom, '<', '/dev/urandom') or die "Can't open /dev/urandom: $!";
read($urandom, my $raw, 32);
close $urandom;
my $tmpname = substr(unpack('H*', $raw), 0, 10);

$tmpname = "$name-$tmpname" if defined $name && length $name;

my $dir     = "$home/sketch/$tmpname";
my $session = "sketch-$tmpname";

make_path($dir);
chdir($dir) or exit 1;

system("git init >/dev/null 2>&1") == 0 or exit 1;

my $ignore_dir = "$home/.ignores";

print "Directory: $dir\n";
print "Session:   $session\n";

system('tmux', 'new-session', '-d', '-s', $session, '-c', $dir);
system('tmux', 'send-keys', '-t', $session, 'nvim .', 'C-m');
system('tmux', 'attach-session', '-t', $session);

if (-t STDIN) {
    # Already in a terminal — just attach directly
    system('tmux', 'attach-session', '-t', $session);
} else {
    # No terminal — spawn one attached to the session
    system('alacritty', '-e', 'tmux', 'attach-session', '-t', $session);
}

exit 0;
